{
  "name": "goodwill-mcp",
  "version": "0.1.0",
  "description": "Goodwill: an unofficial Splitwise MCP server. Explain balances, settle up, add expenses in a sentence. Every write is confirmed and nothing is ever deleted.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:watch": "vitest",
    "dev:stdio": "tsx src/bin/stdio.ts",
    "evals": "tsx evals/run.ts",
    "dev:http": "tsx src/bin/http.ts",
    "conformance": "tsx evals/conformance.ts --expected-failures conformance-baseline.yml",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "smoke:worker": "tsx evals/worker-smoke.ts",
    "evals:model": "tsx evals/model-run.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.135.0",
    "yaml": "^2.9.1"
  }
}
